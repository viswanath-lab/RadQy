{
  "latex-workshop.latex.rootFile.useSubFile": false,
  "latex-workshop.latex.outDir": "%DIR%", // keep outputs next to the root .tex file (works on Win/mac)
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "external",

  "latex-workshop.latex.recipe.default": "build",

  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-output-directory=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "--input-directory=%OUTDIR%",
        "--output-directory=%OUTDIR%",
        "%DOCFILE%"
      ]
    },
    {
      "name": "copy-pdf-to-repo-docs",
      "command": "python",
      "args": [
        "%WORKSPACE_FOLDER%/tools/copy-pdf.py",
        "%OUTDIR%",
        "%DOCFILE%",
        "%WORKSPACE_FOLDER%/docs"
      ]
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "build",
      "tools": ["pdflatex", "biber", "pdflatex", "pdflatex", "copy-pdf-to-repo-docs"]
    }
  ],

  // Hide repo plumbing in Explorer
  "files.exclude": {
    ".git": true,
    ".gitignore": true,
    ".github": true,
    ".vscode": true,
    ".venv": true
  }
}
