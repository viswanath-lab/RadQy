{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RadQy (choose segmenter)",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.radqy",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--inputdir",
        "examples/mri",
        "--scantype",
        "mri",
        "--segmenter",
        "otsuhull",
        "--middle-percent",
        "90",
        "--num-samples",
        "3",
        "--save-fgbg"
      ]
    }
  ]
}
